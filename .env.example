# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults to openai/gpt-oss-120b.
# Groq retires models periodically — check console.groq.com/docs/models
# if ranking starts returning a 404.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Enables Google sign-in + cross-device sync of the want-to-watch
# list. Leave unset to keep the app fully localStorage-only (no login shown).
# From Firebase Console > Project settings > General > Your apps > Web app.
# These are the public web config, safe to expose client-side — real access
# control is enforced by firestore.rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
