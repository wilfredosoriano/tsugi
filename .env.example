# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional. Defaults to openai/gpt-oss-120b.
# Groq retires models periodically — check console.groq.com/docs/models
# if ranking starts returning a 404.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Enables Google sign-in + cross-device sync of the want-to-watch
# list. Leave unset to keep the app fully localStorage-only (no login shown).
# From Firebase Console > Project settings > General > Your apps > Web app.
# These are the public web config, safe to expose client-side — real access
# control is enforced by firestore.rules, not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The OAuth Web Client ID from Google Cloud Console > APIs & Services >
# Credentials > OAuth 2.0 Client IDs (the one Firebase auto-created).
# Public identifier, safe to expose client-side. Required for sign-in —
# see src/components/GoogleSignInButton.jsx for why it's used directly via
# Google Identity Services rather than Firebase's own popup/redirect helpers.
VITE_GOOGLE_CLIENT_ID=

# Optional. Enables push notifications (episode-airing reminders). Generate
# a key pair once with: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY must be the SAME value as VAPID_PUBLIC_KEY — the
# client needs the public half to subscribe, the server needs both halves
# to actually send. VAPID_SUBJECT is a contact URL/mailto required by the
# push protocol (shown to push services, not to users) — your site's own
# URL is fine.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

